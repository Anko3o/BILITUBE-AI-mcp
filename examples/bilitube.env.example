# 复制成 examples/bilitube.env（已被 .gitignore 忽略），给 systemd 的 EnvironmentFile 用；
# 前台跑时用 `set -a; . examples/bilitube.env; set +a` 读进来。两个进程读同一份。
# 都可以不填，等号后面是默认值。要改哪项就把那一行行首的 # 去掉。
# 注意：说明一律写在上一行。等号后面不要再跟空格和注释——systemd 会把它们当成值的一部分。
# 值里有引号（比如 JSON）就整个用单引号包起来，systemd 和 shell 都认。

# ── 后端（server/bilitube_server.py）──
# 后端端口；改了要同步改下面 MCP 那段的 BILITUBE_SERVER_URL
# BILITUBE_PORT=18008
# 状态、私人弹幕、设置（默认 <仓库>/data/server）
# BILITUBE_DATA_DIR=
# 本地片源（默认 <仓库>/data/films）
# BILITUBE_FILM_DIR=
# 二维码、截图、封面缓存（默认 <仓库>/data/images）；MCP 那头要用同一个
# BILITUBE_IMAGE_DIR=
# 页面挂在反向代理的哪个前缀下；改了要同步改 MCP 的 BILITUBE_PAGE_URL 和反向代理
# BILITUBE_URL_PREFIX=/bilitube
# MCP 在哪；改了 BILITUBE_MCP_PORT 要同步改这里
# BILITUBE_BILI_MCP=http://127.0.0.1:18013
# 用户、AI 的默认称呼（页面设置里改过的优先）
# BILITUBE_USER_NAME=TA
# BILITUBE_COMPANION_NAME=AI
# 可选：直播接口用的 B 站 cookie 文件（一行 k=v; k=v）；不配就匿名
# BILITUBE_COOKIE=
# 0＝不连直播公开弹幕
# BILITUBE_LIVE_DM=1

# 推送：用户发弹幕时推一段文字给你自己的聊天后端。不配 URL 就只写 data/server/outbox.log
# BILITUBE_PUSH_URL=https://your-chat-backend.example/inbox
# 令牌放进 Authorization: Bearer；或者用 BILITUBE_PUSH_TOKEN_FILE 指一个文件（只读第一行）
# BILITUBE_PUSH_TOKEN=
# BILITUBE_PUSH_TOKEN_FILE=
# 每条推送额外带的固定字段（JSON，用单引号包）
# BILITUBE_PUSH_EXTRA='{"room":"together"}'
# 推送文字开头的标记，接收方靠它认弹幕
# BILITUBE_DM_TAG=【bilitube·弹幕】
# 1＝开映／暂停／看完也推
# BILITUBE_PUSH_EVENTS=0
# 1＝推送里附上那一刻的画面（base64 JPEG）
# BILITUBE_DM_FRAME=0
# 0＝配了 URL 也先不推（只写 outbox.log）
# BILITUBE_PUSH=1

# ── MCP（mcp/bili_mcp.py）──
# MCP 端口；改了要同步改上面的 BILITUBE_BILI_MCP 和 AI 客户端里登记的地址
# BILITUBE_MCP_PORT=18013
# 后端在哪；改了 BILITUBE_PORT 要同步改这里
# BILITUBE_SERVER_URL=http://127.0.0.1:18008
# 回话里「在页面上打开」的链接前缀，跟 BILITUBE_URL_PREFIX 对上
# BILITUBE_PAGE_URL=/bilitube/
# 扫码登录后的凭据（默认 mcp/state/cred.json，0600）
# BILI_CRED_FILE=
# 缓存（默认 mcp/state/cache）
# BILI_CACHE_DIR=
# 预算和口袋夹子（默认 mcp/config.json，照 config.example.json）
# BILI_CONFIG=
# AI 自己收藏时唯一能进的夹子（必须是私密的）
# BILI_POCKET_FOLDER_ID=
# 每小时上限：AI 通道总请求、其中点赞＋收藏＋关注、网页通道（0＝不限）
# BILI_HOURLY_BUDGET=30
# BILI_WRITE_HOURLY_BUDGET=20
# BILI_REST_HOURLY_BUDGET=0
# AI 自己关注的 UP 放进的关注分组：填 id，或不填 id 按名字认（默认「AI 的关注」）；分组要先在 B 站上自己建好
# BILI_FOLLOW_GROUP_ID=
# BILI_FOLLOW_GROUP_NAME=AI 的关注
# 关注＋取关：每小时上限、两次之间至少隔几秒
# BILI_FOLLOW_HOURLY_BUDGET=5
# BILI_FOLLOW_MIN_GAP=60
# 截图（att-scene-*）和封面（att-bili-cover-*）在 BILITUBE_IMAGE_DIR 里留几天，过期由 MCP 进程每天清一次；0＝不清
# BILI_SCENE_KEEP_DAYS=7
# stage card 推荐卡发到哪；不配就不发卡
# BILITUBE_CARD_URL=
# 推荐卡的令牌，或者用 BILITUBE_CARD_TOKEN_FILE 指一个文件
# BILITUBE_CARD_TOKEN=
# BILITUBE_CARD_TOKEN_FILE=
